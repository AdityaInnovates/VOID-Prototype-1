<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VoidPhone" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#0B0B0F</item>
        <item name="colorPrimary">#6E8BFF</item>
        <item name="colorOnPrimary">#0B0B0F</item>
    </style>

    <style name="VoidHeader" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textColor">#6E8BFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
</resources>
